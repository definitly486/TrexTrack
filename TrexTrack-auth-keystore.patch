@@ -0,0 +1,216 @@
+package org.definitly.trextrack
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.FormBody
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONObject
+import java.net.URLDecoder
+import java.util.UUID
+import java.util.concurrent.TimeUnit
+
+/**
+ * Direct Zepp/Huami account login without the Zepp app.
+ *
+ * Flow:
+ *  1) POST email+password → temporary access (and optional refresh) code
+ *  2) Exchange access code → app_token + user_id
+ *
+ * Notes:
+ *  - Official Open Platform needs partner approval; this uses the reverse-engineered
+ *    mobile/web account endpoints used by community tools.
+ *  - Since ~2025 some regions require an encrypted body on step 1. If you get HTTP 400
+ *    on /v2/registrations/tokens, implement encryptPayload() with the current AES scheme
+ *    observed in community clients (e.g. huami-token) and send raw encrypted bytes.
+ *  - Never log email/password or tokens.
+ */
+class ZeppAuthClient(
+    private val client: OkHttpClient = defaultClient()
+) {
+    suspend fun login(email: String, password: CharArray): Result<ZeppSession> =
+        withContext(Dispatchers.IO) {
+            try {
+                val trimmed = email.trim()
+                require(trimmed.isNotEmpty()) { "Email пуст" }
+                require(password.isNotEmpty()) { "Пароль пуст" }
+
+                val (access, _, country) = requestAccessCode(trimmed, password)
+                val session = exchangeForAppToken(access, country)
+                Result.success(session.copy(email = trimmed))
+            } catch (e: Exception) {
+                Result.failure(e)
+            } finally {
+                password.fill('\u0000')
+            }
+        }
+
+    private fun requestAccessCode(
+        email: String,
+        password: CharArray
+    ): Triple<String, String?, String> {
+        // Plain form body. Replace with encrypted payload when the endpoint requires it.
+        val form = FormBody.Builder()
+            .add("emailOrPhone", email)
+            .add("password", String(password))
+            .add("state", "REDIRECTION")
+            .add("client_id", "HuaMi")
+            .add("redirect_uri", REDIRECT_URI)
+            .add("region", "us-west-2")
+            .add("token", "access")
+            .add("token", "refresh")
+            .add("country_code", "US")
+            .build()
+
+        val request = Request.Builder()
+            .url(URL_REGISTRATIONS_TOKENS)
+            .post(form)
+            .header("app_name", APP_NAME)
+            .header("appname", APP_NAME)
+            .header("appplatform", "android_phone")
+            .header("content-type", "application/x-www-form-urlencoded; charset=UTF-8")
+            .header("user-agent", USER_AGENT_APP)
+            .header("x-request-id", UUID.randomUUID().toString())
+            .header("accept-encoding", "gzip")
+            .build()
+
+        client.newCall(request).execute().use { resp ->
+            val location = resp.header("Location")
+            if (location == null) {
+                val body = resp.body?.string().orEmpty()
+                error(
+                    "Нет Location при логине (HTTP ${resp.code}). " +
+                        "Возможно, требуется encrypted body. Ответ: ${body.take(200)}"
+                )
+            }
+            val params = parseQuery(location)
+            if (params.containsKey("error")) {
+                error("Сервер отклонил учётные данные (error=${params["error"]})")
+            }
+            val access = params["access"]
+                ?: error("В redirect нет access: ${location.take(120)}")
+            val refresh = params["refresh"]
+            val country = params["country_code"] ?: "US"
+            return Triple(access, refresh, country)
+        }
+    }
+
+    private fun exchangeForAppToken(accessCode: String, countryCode: String): ZeppSession {
+        val deviceId = UUID.randomUUID().toString()
+        val form = FormBody.Builder()
+            .add("app_name", APP_NAME)
+            .add("app_version", APP_VERSION)
+            .add("code", accessCode)
+            .add("country_code", countryCode)
+            .add("device_id", deviceId)
+            .add("device_model", "android_phone")
+            .add("grant_type", "access_token")
+            .add("allow_registration", "false")
+            .add("third_name", "huami")
+            .add("dn", DN_LIST)
+            .add("lang", "en")
+            .add("source", "com.huami.watch.hmwatchmanager:$APP_VERSION")
+            .build()
+
+        // Webapp-style headers are often required for /v2/client/login
+        val request = Request.Builder()
+            .url(URL_CLIENT_LOGIN)
+            .post(form)
+            .header("app_name", "com.huami.webapp")
+            .header("appname", "com.huami.webapp")
+            .header("origin", "https://user.zepp.com")
+            .header("referer", "https://user.zepp.com/")
+            .header("user-agent", USER_AGENT_WEB)
+            .header("content-type", "application/x-www-form-urlencoded; charset=UTF-8")
+            .header("accept", "application/json, text/plain, */*")
+            .header("accept-language", "en-US,en;q=0.9")
+            .build()
+
+        client.newCall(request).execute().use { resp ->
+            val body = resp.body?.string()
+                ?: error("Пустой ответ login (HTTP ${resp.code})")
+            if (!resp.isSuccessful) {
+                error("Login HTTP ${resp.code}: ${body.take(300)}")
+            }
+
+            val json = JSONObject(body)
+            val tokenInfo = json.optJSONObject("token_info")
+                ?: error("Нет token_info в ответе: ${body.take(200)}")
+
+            val appToken = tokenInfo.optString("app_token").ifBlank {
+                error("Нет app_token")
+            }
+            val userId = tokenInfo.optString("user_id").ifBlank {
+                error("Нет user_id")
+            }
+            val loginToken = tokenInfo.optString("login_token").ifBlank { null }
+
+            val host = resolveRegionHost(json)
+
+            return ZeppSession(
+                appToken = appToken,
+                userId = userId,
+                loginToken = loginToken,
+                regionHost = host
+            )
+        }
+    }
+
+    private fun resolveRegionHost(json: JSONObject): String {
+        val domains = json.optJSONArray("domains") ?: return ZeppSession.DEFAULT_REGION_HOST
+        for (i in 0 until domains.length()) {
+            val d = domains.optJSONObject(i) ?: continue
+            val host = d.optString("host")
+            if (host.contains("mifit", ignoreCase = true)) {
+                val cnames = d.optJSONArray("cnames")
+                val cname = cnames?.optString(0)?.takeIf { it.isNotBlank() }
+                if (cname != null) return "https://$cname"
+            }
+        }
+        return ZeppSession.DEFAULT_REGION_HOST
+    }
+
+    private fun parseQuery(url: String): Map<String, String> {
+        val q = url.substringAfter('?', missingDelimiterValue = "")
+        if (q.isEmpty()) return emptyMap()
+        return q.split('&')
+            .mapNotNull { part ->
+                val i = part.indexOf('=')
+                if (i <= 0) null
+                else {
+                    val k = URLDecoder.decode(part.substring(0, i), Charsets.UTF_8.name())
+                    val v = URLDecoder.decode(part.substring(i + 1), Charsets.UTF_8.name())
+                    k to v
+                }
+            }
+            .toMap()
+    }
+
+    companion object {
+        private const val APP_NAME = "com.huami.midong"
+        private const val APP_VERSION = "9.12.5"
+        private const val REDIRECT_URI =
+            "https://s3-us-west-2.amazonaws.com/hm-registration/successsignin.html"
+        private const val URL_REGISTRATIONS_TOKENS =
+            "https://api-user.zepp.com/v2/registrations/tokens"
+        private const val URL_CLIENT_LOGIN =
+            "https://account.huami.com/v2/client/login"
+        private const val DN_LIST =
+            "account.zepp.com,api-user.zepp.com,api-mifit.zepp.com," +
+                "api-watch.zepp.com,app-analytics.zepp.com,auth.zepp.com"
+        private const val USER_AGENT_APP =
+            "Zepp/9.12.5 (Linux; Android 13; Density/2.75)"
+        private const val USER_AGENT_WEB =
+            "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 " +
+                "(KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
+
+        private fun defaultClient(): OkHttpClient =
+            OkHttpClient.Builder()
+                .followRedirects(false)
+                .followSslRedirects(false)
+                .connectTimeout(30, TimeUnit.SECONDS)
+                .readTimeout(30, TimeUnit.SECONDS)
+                .writeTimeout(30, TimeUnit.SECONDS)
+                .build()
+    }
+}
